{
  "name": "zoom3d",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @zoom3d/server --filter @zoom3d/web dev",
    "test": "vitest run",
    "typecheck": "tsc -p packages/shared && tsc -p apps/web && tsc -p apps/server",
    "lint": "biome check .",
    "e2e": "pnpm --filter @zoom3d/web e2e",
    "bench": "vitest bench --run --reporter=verbose"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@types/node": "22",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
