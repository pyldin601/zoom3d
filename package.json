{
  "name": "zoom3d",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm run \"/^dev:/\"",
    "dev:apps": "pnpm --parallel --filter @zoom3d/server --filter @zoom3d/web dev",
    "dev:livekit": "livekit-server --dev --bind 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc -p packages/shared && tsc -p apps/web && tsc -p apps/server",
    "lint": "biome check .",
    "e2e": "pnpm --filter @zoom3d/web e2e",
    "bench": "vitest bench --run --reporter=verbose",
    "bench:walls": "pnpm --filter @zoom3d/server exec esbuild ../web/bench/walls.ts --bundle --platform=node --format=esm --outfile=../../node_modules/.cache/bench-walls.mjs --log-level=warning && node node_modules/.cache/bench-walls.mjs",
    "bench:sprites": "pnpm --filter @zoom3d/server exec esbuild ../web/bench/sprites.ts --bundle --platform=node --format=esm --outfile=../../node_modules/.cache/bench-sprites.mjs --log-level=warning && node node_modules/.cache/bench-sprites.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "24",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
