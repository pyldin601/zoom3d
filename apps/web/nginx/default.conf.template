# Rendered by the nginx image entrypoint: only defined env vars (SERVER_URL,
# NGINX_LOCAL_RESOLVERS) are substituted; nginx's own $variables are left alone.
server {
    listen 8080;
    root /usr/share/nginx/html;

    # Resolve the server at request time so nginx starts even if it is not up yet.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    location = /ws {
        set $zoom3d_server ${SERVER_URL};
        proxy_pass $zoom3d_server;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # While the server restarts its Service has no endpoints and connects hang instead of failing. Give up
        # fast (not the 60 s default): browsers queue every other WebSocket to this host behind a hung handshake.
        proxy_connect_timeout 3s;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location = /healthz {
        default_type text/plain;
        return 200 "ok";
    }

    # Vite emits content-hashed file names under /assets.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Self-hosted MediaPipe model + wasm (face framing). A missing file must 404, not fall back to index.html.
    location /mediapipe/ {
        add_header Cache-Control "public, max-age=86400";
        try_files $uri =404;
    }

    # SPA: room links (/r/<id>) and the landing page are all index.html.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
